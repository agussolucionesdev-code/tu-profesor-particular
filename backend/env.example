# ── Backend environment variables ──────────────────────────────────────────
# Rename to .env for local dev. Set secrets in the Render dashboard for prod.
# Variables marked SECRET must NEVER be committed to git.

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_TIME_ZONE=America/Argentina/Buenos_Aires
TRUST_PROXY=1

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/tuprofesor?retryWrites=true&w=majority   # SECRET
MONGO_FALLBACK_TO_MEMORY=false

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=<strong-random-64-char-hex>   # SECRET — generate: openssl rand -hex 32
JWT_EXPIRES_IN=8h
JWT_ISSUER=tu-profesor-particular-backend
JWT_AUDIENCE=tu-profesor-particular-admin

# ── Admin credentials ────────────────────────────────────────────────────────
ADMIN_USERNAME=agustin   # SECRET
ADMIN_PASSWORD=<strong-password>   # SECRET

# ── CORS / URLs ─────────────────────────────────────────────────────────────
CORS_ORIGIN=https://tuprofesorparticular.com.ar
FRONTEND_URL=https://tuprofesorparticular.com.ar

# ── Email (Gmail App Password) ───────────────────────────────────────────────
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=agustinsosa.profe@gmail.com   # SECRET
EMAIL_PASS=<gmail-app-password-16-chars>  # SECRET
OWNER_NOTIFICATION_EMAIL=agustinsosa.profe@gmail.com

# ── Teacher profile (shown in email signature) ───────────────────────────────
TEACHER_EMAIL=agustinsosa.profe@gmail.com
CONTACT_PHONE=+54 9 11 6423-6675
TEACHER_ADDRESS=Jujuy 414, Temperley, Buenos Aires
TEACHER_MAPS_URL=https://maps.app.goo.gl/XXXXXXXXX

# ── Google Sheets integration ────────────────────────────────────────────────
GOOGLE_SHEET_ID=<spreadsheet-id-from-url>   # SECRET
GOOGLE_SHEET_TITLE=Reservas
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account>@<project>.iam.gserviceaccount.com   # SECRET
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"  # SECRET

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
PUBLIC_LOOKUP_RATE_LIMIT_MAX=40
PUBLIC_MUTATION_RATE_LIMIT_MAX=30

# ── Misc ─────────────────────────────────────────────────────────────────────
MAX_AVAILABILITY_RANGE_DAYS=120
SERVER_REQUEST_TIMEOUT_MS=15000
SERVER_HEADERS_TIMEOUT_MS=20000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
