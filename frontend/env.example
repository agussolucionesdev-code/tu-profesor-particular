# ── Frontend environment variables ─────────────────────────────────────────
# Rename to .env.local for local dev. Set these in the Vercel dashboard for prod.
# All variables MUST start with VITE_ to be exposed to the browser.

# Backend URL — Render web service URL (no trailing slash)
VITE_BACKEND_URL=https://tu-profesor-particular-backend.onrender.com

# Social links shown in the footer (optional — fallback to generic URLs if omitted)
VITE_INSTAGRAM_URL=https://instagram.com/tuprofesorparticular
VITE_FACEBOOK_URL=https://facebook.com/tuprofesorparticular
VITE_LINKEDIN_URL=https://linkedin.com/in/agustin-sosa
