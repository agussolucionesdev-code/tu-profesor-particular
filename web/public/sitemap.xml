<?xml version="1.0" encoding="UTF-8"?>
<!--
  Las 5 rutas indexables del sitio. El 404 queda afuera a propósito.

  Sin `lastmod`: un valor puesto a mano se desactualiza al primer cambio y
  Google descuenta las fechas en las que deja de confiar. Es preferible no
  declararla a declararla mal.

  `priority` es relativa dentro del propio sitio: la portada primero, después
  las dos páginas que responden "¿das mi materia?" y "¿quién sos?", que son las
  preguntas con las que llega la gente.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://tuprofesorparticular.com.ar/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://tuprofesorparticular.com.ar/materias</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://tuprofesorparticular.com.ar/sobre-mi</loc>
    <changefreq>yearly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://tuprofesorparticular.com.ar/como-trabajo</loc>
    <changefreq>yearly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://tuprofesorparticular.com.ar/contacto</loc>
    <changefreq>yearly</changefreq>
    <priority>0.7</priority>
  </url>
  <!-- La prioridad más baja del sitio, y a propósito: tiene que ser encontrable
       —quien busca cómo se manejan sus datos merece encontrarla— pero no debe
       competir con las páginas que traen alumnos. -->
  <url>
    <loc>https://tuprofesorparticular.com.ar/privacidad</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
